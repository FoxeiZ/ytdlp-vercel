<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ytdlp frontend</title>
    <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='styles/global.css') }}" />
    <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='styles/modal.css') }}" />
    <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='styles/awm.css') }}" />
    <script src="{{ url_for('static', filename='scripts/dist/webpack.js') }}"></script>
    <script src="{{ url_for('static', filename='scripts/main.js') }}"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
  </head>

  <body x-cloak x-data="ytdlApp()">
    <div class="page-shell">
      <header class="app-bar">
        <div class="app-bar__brand">
          <div class="brand-mark">
            <img src="{{ url_for('static', filename='images/youtube-music-logo.png') }}"
                 alt="YouTube Music logo"
                 width="40"
                 height="40"
                 class="brand-logo" />
          </div>
          <div class="brand-copy">
            <div class="brand-title">ytdlp</div>
            <div class="brand-subtitle">uhh, still don't know what to put here</div>
          </div>
        </div>
        <div class="app-bar__actions">
          <button-component id="open-about-modal" class="btn btn--outlined box-outline" @click="modals.about = true">
            about
          </button-component>
          <button-component id="open-donate-modal" class="btn btn--outlined box-outline" @click="modals.about = true">
            donate
          </button-component>
          <button-component id="open-settings-modal" class="btn btn--outlined box-outline" @click="modals.settings = true">
            settings
          </button-component>
        </div>
      </header>

      <main class="page-content">
        <section id="main-toolbox" class="surface-card">
          <div id="logo-area" class="hero">
            <div class="hero-text">
              <h1 class="hero-title">ytdlp frontend</h1>
              <p class="hero-subtitle">Paste a link, pick a preset and start download.</p>
            </div>
          </div>
          <div id="download-area">
            <div class="field">
              <input autocomplete="off"
                     type="text"
                     id="url-input"
                     placeholder="https://www.youtube.com/watch?v=..."
                     aria-describedby="url-support"
                     x-model="url" />
              <p class="field-support" id="url-support">
                Works with standard YouTube links and playlists. More to come.
              </p>
            </div>
            <div id="custom-button-area" class="action-row">
              <div class="av-wrapper" aria-label="Download type">
                <button-component id="video-switch" class="btn--segment" :class="{ 'selected': downloadType === 'video' }" @click="downloadType = 'video'">
                  video
                </button-component>
                <button-component id="audio-switch" class="btn--segment" :class="{ 'selected': downloadType === 'audio' }" @click="downloadType = 'audio'">
                  audio
                </button-component>
              </div>
              <button-component id="download-button" class="btn btn--primary" :class="{ 'disabled': !isValidUrl || isDownloading, 'red': isError, 'no-opacity': noOpacity }" @click="handleSubmit()" x-text="downloadText">
                download
              </button-component>
            </div>
            <div class="helper-row"
                 x-show="downloadType === 'video'"
                 x-transition:enter="helper-enter"
                 x-transition:enter-start="helper-enter-from"
                 x-transition:enter-end="helper-enter-to"
                 x-transition:leave="helper-leave"
                 x-transition:leave-start="helper-leave-from"
                 x-transition:leave-end="helper-leave-to">
              <template x-for="p in videoPresets" :key="p.value">
                <span class="helper-chip helper-chip--interactive"
                      :class="{ 'helper-chip--active': ytdlFormatVideo === p.value }"
                      @click="ytdlFormatVideo = p.value"
                      x-text="p.title"></span>
              </template>
            </div>
            <div class="helper-row"
                 x-show="downloadType === 'audio'"
                 x-transition:enter="helper-enter"
                 x-transition:enter-start="helper-enter-from"
                 x-transition:enter-end="helper-enter-to"
                 x-transition:leave="helper-leave"
                 x-transition:leave-start="helper-leave-from"
                 x-transition:leave-end="helper-leave-to">
              <template x-for="p in audioPresets" :key="p.value">
                <span class="helper-chip helper-chip--interactive"
                      :class="{ 'helper-chip--active': ytdlFormatAudio === p.value }"
                      @click="ytdlFormatAudio = p.value"
                      x-text="p.title"></span>
              </template>
            </div>
          </div>
        </section>
      </main>

      <footer class="page-footer">
        <div class="footer-note">No external UI libraries. Just HTML, CSS, and yt-dlp.</div>
      </footer>
    </div>

    <!-- settings modal -->
    <div class="modal"
         id="settings-modal"
         x-show="modals.settings"
         x-transition.opacity.duration.200ms
         @click.self="modals.settings = false">
      <p class="modal-title">settings</p>
      <div class="modal-content">
        <!-- tabs settings -->
        <div class="tabs-container" id="settings-tabs">
          <div class="tab-buttons">
            <button class="tab-button" :class="{ 'active': settingsTab === 0 }" @click="settingsTab = 0">
              yt-dlp
            </button>
            <button class="tab-button" :class="{ 'active': settingsTab === 1 }" @click="settingsTab = 1">
              FFmpeg
            </button>
          </div>
          <div class="tab-content">
            <!-- 0: yt-dlp config -->
            <div class="tab-pane" :class="{ 'active': settingsTab === 0 }">
              <!-- video presets -->
              <div id="format-selector-video" x-show="downloadType === 'video'">
                <div class="input-modal-options">
                  <div class="input-modal-left">
                    <div class="input-modal-title">Video Presets</div>
                    <div class="input-modal-description" id="ytdl-fsl-video-desc" x-text="videoFormatDesc"></div>
                  </div>
                  <select id="ytdl-fsl-video" x-model="ytdlFormatVideo">
                    <template x-for="p in videoPresets" :key="p.value">
                      <option :value="p.value" x-text="p.title" :selected="p.value === ytdlFormatVideo"></option>
                    </template>
                  </select>
                </div>
              </div>
              <!-- audio presets -->
              <div id="format-selector-audio" x-show="downloadType === 'audio'">
                <div class="input-modal-options">
                  <div class="input-modal-left">
                    <div class="input-modal-title">Audio Presets</div>
                    <div class="input-modal-description" id="ytdl-fsl-audio-desc" x-text="audioFormatDesc"></div>
                  </div>
                  <select id="ytdl-fsl-audio" x-model="ytdlFormatAudio">
                    <template x-for="p in audioPresets" :key="p.value">
                      <option :value="p.value" x-text="p.title" :selected="p.value === ytdlFormatAudio"></option>
                    </template>
                  </select>
                </div>
              </div>
              <!-- custom format input -->
              <div id="custom-format-input-wrapper" x-show="showCustomFormat">
                <div class="input-modal-options">
                  <div class="input-modal-left">
                    <div class="input-modal-title">Custom Format</div>
                    <div class="input-modal-description">Enter a custom yt-dlp format string.</div>
                  </div>
                  <input id="ytdl-fsl-custom" type="text" x-model="ytdlFormatCustom" />
                </div>
              </div>
            </div>

            <!-- 1: ffmpeg -->
            <div class="tab-pane" :class="{ 'active': settingsTab === 1 }">
              <!-- ffmpeg toggle -->
              <div class="toggle-modal-options">
                <div class="toggle-modal-left">
                  <div class="toggle-modal-title">Use FFmpeg</div>
                  <div class="toggle-modal-description">
                    If enabled, allows merging separate video and audio streams for higher quality. Requires a bit more processing time.
                  </div>
                </div>
                <label class="modal-toggle-button">
                  <input id="use-ffmpeg" type="checkbox" x-model="useFfmpeg" />
                  <div>
                    <span></span>
                  </div>
                </label>
              </div>
              <!-- lyrics fetch toggle -->
              <div class="toggle-modal-options">
                <div class="toggle-modal-left">
                  <div class="toggle-modal-title">Fetch Lyrics</div>
                  <div class="toggle-modal-description">
                    If enabled, attempts to fetch and embed lyrics into the downloaded file. Only works when FFmpeg is processing.
                  </div>
                </div>
                <label class="modal-toggle-button">
                  <input id="fetch-lyrics" type="checkbox" x-model="fetchLyrics" />
                  <div>
                    <span></span>
                  </div>
                </label>
              </div>
              <div id="lyrics-provider-wrapper" x-show="fetchLyrics">
                <div class="input-modal-options">
                  <div class="input-modal-left">
                    <div class="input-modal-title">Lyrics Provider</div>
                    <div class="input-modal-description" id="lyrics-provider-desc" x-text="lyricsProviderDesc"></div>
                  </div>
                  <select id="lyrics-provider" x-model="lyricsProvider">
                    <template x-for="p in lyricsProviders" :key="p.value">
                      <option :value="p.value" x-text="p.title" :selected="p.value === lyricsProvider"></option>
                    </template>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button-component class="js-modal-close" @click="modals.settings = false">
        close
      </button-component>
    </div>

    <div class="modal"
         id="about-modal"
         x-show="modals.about"
         x-transition.opacity.duration.200ms
         @click.self="modals.about = false">
      <p class="modal-title">about</p>
      <div class="modal-content">
        <div class="about-content">
          <h2>What is this thing?</h2>
          <p>A very long-winded way of accessing yt-dlp. Nothing fancy, nothing malicious.</p>
          <hr>
          <h2>Why?</h2>
          <p>Because I can. And because it's fun.</p>
          <hr>
          <h2>Disclaimer</h2>
          <p>I am not responsible for any misuse of this tool. Please use it responsibly.</p>
          <hr>
          <h2>Changelog</h2>
          <ul class="changelog-list" id="changelog-list">
            <template x-if="changelogItems === null">
              <li>Loading recent changes...</li>
            </template>
            <template x-if="changelogItems !== null && changelogItems.length === 0">
              <li>No recent changes found.</li>
            </template>
            <template x-for="pr in (changelogItems || [])" :key="pr.url">
              <li>
                <a :href="pr.url" target="_blank" rel="noopener noreferrer">
                  <strong x-text="pr.title"></strong>
                </a>
                <span>Merged on <span x-text="pr.merged_at"></span> by <a :href="pr.user_url" target="_blank" rel="noopener noreferrer" x-text="pr.user"></a></span>
              </li>
            </template>
          </ul>
        </div>
      </div>
      <button-component class="js-modal-close" @click="modals.about = false">
        close
      </button-component>
    </div>

  </body>
</html>
